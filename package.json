{
  "name": "examples-js-vue",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pnpm --filter \"./packages/**\" --parallel --if-present build-only",
    "typecheck": "pnpm --filter \"./packages/**\" --parallel --if-present typecheck ",
    "lint": "pnpm lint:style & pnpm lint:packages",
    "lint:packages": "pnpm --filter \"./packages/**\" --if-present lint",
    "lint:style": "stylelint --cache \"**/*.{css,scss,vue}\"",
    "format": "oxfmt --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxfmt": "^0.67.0",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3"
  }
}
