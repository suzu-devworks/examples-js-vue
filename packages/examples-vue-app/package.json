    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "catalog:",
    "npm-run-all2": "^9.0.3",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sass-embedded": "^1.105.2",
    "typescript": "catalog:",
