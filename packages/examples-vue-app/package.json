{
  "name": "examples-vue-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:deps && vite build",
    "build:checks": "run-p typecheck \"build {@}\" --",
    "build:deps": "pnpm --filter examples-vue-shared build",
    "dev": "pnpm build:deps && vite --host 0.0.0.0",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --cache",
    "lint:oxlint": "oxlint --type-aware .",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "pnpm build:deps && vue-tsc --build"
  },
  "dependencies": {
    "examples-vue-shared": "workspace:*",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@examples/eslint-config": "workspace:*",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "catalog:",
    "npm-run-all2": "^9.0.3",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sass-embedded": "^1.105.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
